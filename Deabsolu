local resizeHandle = Instance.new("TextButton")
resizeHandle.Size = UDim2.new(0, 22, 0, 22)
resizeHandle.Position = UDim2.new(1, -22, 1, -22)
resizeHandle.BackgroundColor3 = C.Accent
resizeHandle.BackgroundTransparency = 0.15
resizeHandle.BorderSizePixel = 0
resizeHandle.Text = "◢"
resizeHandle.TextColor3 = Color3.fromRGB(255, 255, 255)
resizeHandle.TextSize = 14
resizeHandle.Font = Enum.Font.GothamBold
resizeHandle.AutoButtonColor = false
resizeHandle.ZIndex = 20
resizeHandle.Parent = menu
Instance.new("UICorner", resizeHandle).CornerRadius = UDim.new(0, 6)

local rStrokeH = Instance.new("UIStroke")
rStrokeH.Color = Color3.fromRGB(255, 255, 255)
rStrokeH.Thickness = 1.5
rStrokeH.Transparency = 0.6
rStrokeH.Parent = resizeHandle

local resizing = false
local resizeStart, startSize

resizeHandle.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        resizing = true
        resizeStart = input.Position
        startSize = menu.Size
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if not resizing then return end
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        local delta = input.Position - resizeStart
        local newW = math.clamp(startSize.X.Offset + delta.X, 400, 900)
        local newH = math.clamp(startSize.Y.Offset + delta.Y, 280, 800)
        local newSize = UDim2.new(0, newW, 0, newH)
        menu.Size = newSize
        OPEN_SIZE = newSize
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        resizing = false
    end
end)

resizeHandle.MouseEnter:Connect(function()
    TweenService:Create(rStrokeH, TweenInfo.new(0.15), {Transparency = 0}):Play()
    TweenService:Create(resizeHandle, TweenInfo.new(0.15), {BackgroundTransparency = 0}):Play()
end)
resizeHandle.MouseLeave:Connect(function()
    TweenService:Create(rStrokeH, TweenInfo.new(0.15), {Transparency = 0.6}):Play()
    TweenService:Create(resizeHandle, TweenInfo.new(0.15), {BackgroundTransparency = 0.15}):Play()
end)

-- ============ APPLY THEME ============
local function applyTheme(theme)
    C = theme

    toggleBtn.BackgroundColor3 = theme.Panel
    toggleStroke.Color = theme.Accent
    icon.TextColor3 = theme.AccentGlow
    btnText.TextColor3 = theme.Text
    accentBar.BackgroundColor3 = theme.Accent

    menu.BackgroundColor3 = theme.Bg
    menuStroke.Color = theme.Accent

    if theme.isLight then
        darkOverlay.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        darkOverlay.BackgroundTransparency = 0.35
        bgGrad.Transparency = NumberSequence.new(0.95)
    else
        darkOverlay.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
        darkOverlay.BackgroundTransparency = 0.45
        bgGrad.Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0.55),
            NumberSequenceKeypoint.new(0.5, 0.6),
            NumberSequenceKeypoint.new(1, 0.35),
        })
    end
    bgGrad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
        ColorSequenceKeypoint.new(0.55, Color3.fromRGB(60, 60, 70)),
        ColorSequenceKeypoint.new(1, theme.Accent),
    })

    watermark.TextColor3 = theme.AccentGlow
    watermarkShadow.TextColor3 = theme.Bg

    sepLine.BackgroundColor3 = theme.Off

    themeBtn.BackgroundColor3 = theme.Panel
    themeBtn.TextColor3 = theme.AccentGlow
    themeStroke.Color = theme.Accent

    closeBtn.BackgroundColor3 = theme.Accent

    for i, t in ipairs(tabs) do
        if i == activeTab then
            t.BackgroundColor3 = theme.Accent
            t.BackgroundTransparency = 0
            t.TextColor3 = Color3.fromRGB(255, 255, 255)
        else
            t.BackgroundColor3 = theme.Panel
            t.BackgroundTransparency = 0.35
            t.TextColor3 = theme.SubText
        end
    end

    profile.BackgroundColor3 = theme.Panel
    profileStroke.Color = theme.Accent
    avatarFrame.BackgroundColor3 = theme.BgGrad
    avatarStroke.Color = theme.Accent
    nameLabel.TextColor3 = theme.Text
    subLabel.TextColor3 = theme.SubText
    statusPill.BackgroundColor3 = theme.Accent
    statsDivider.BackgroundColor3 = theme.Off
    profileFpsTitle.TextColor3 = theme.SubText
    profilePingTitle.TextColor3 = theme.SubText

    contentESP.ScrollBarImageColor3 = theme.Accent
    contentFPS.ScrollBarImageColor3 = theme.Accent
    contentVISUALS.ScrollBarImageColor3 = theme.Accent

    fpsRoot.BackgroundColor3 = theme.Bg
    fpsStroke.Color = theme.Accent
    fpsAccent.BackgroundColor3 = theme.Accent
    fpsTitle.TextColor3 = theme.SubText
    fpsLabel.TextColor3 = theme.Text

    themeBtnBig.BackgroundColor3 = theme.Panel
    themeBtnBigStroke.Color = theme.Off
    themeBtnBigIcon.TextColor3 = theme.AccentGlow
    themeBtnBigText.TextColor3 = theme.Text
    themeBtnBigText.Text = "Тема: " .. theme.name

    resizeHandle.BackgroundColor3 = theme.Accent

    for _, s in ipairs(allSwitches) do
        s.row.BackgroundColor3 = theme.Panel
        s.stroke.Color = theme.Off
        s.label.TextColor3 = theme.Text
        s.sw.BackgroundColor3 = s.getState() and theme.Accent or theme.Off
    end

    for _, cr in ipairs(allColorRows) do
        cr.row.BackgroundColor3 = theme.Panel
        cr.stroke.Color = theme.Off
        cr.label.TextColor3 = theme.Text
    end

    for _, st in ipairs(allSteppers) do
        st.row.BackgroundColor3 = theme.Panel
        st.stroke.Color = theme.Off
        st.label.TextColor3 = theme.Text
        st.btn.BackgroundColor3 = theme.Accent
    end
    if trailColorBtn then
        trailColorBtn.BackgroundColor3 = TRAIL_COLORS[currentTrailColorIndex].color
    end
    if particleColorBtn then
        particleColorBtn.BackgroundColor3 = PARTICLE_COLORS[currentParticleColorIndex].btnColor
    end

    if espEnabled then
        for _, p in ipairs(Players:GetPlayers()) do
            if p.Character then
                local h = p.Character:FindFirstChild("PlayerHighlight")
                if h then h.FillColor = theme.Accent end
            end
        end
    end
end

local function nextTheme()
    currentThemeIndex = currentThemeIndex + 1
    if currentThemeIndex > #THEMES then currentThemeIndex = 1 end
    applyTheme(THEMES[currentThemeIndex])
end

themeBtn.MouseButton1Click:Connect(nextTheme)
