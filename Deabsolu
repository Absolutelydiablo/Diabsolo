-- ============ BLUR ============
local blur = Instance.new("BlurEffect")
blur.Size = 0
blur.Parent = Lighting
local function setBlur(on)
    if not blurEnabled then
        TweenService:Create(blur, TweenInfo.new(0.3), {Size = 0}):Play()
        return
    end
    TweenService:Create(blur, TweenInfo.new(0.35, Enum.EasingStyle.Quart), {Size = on and 18 or 0}):Play()
end
local function setBlurEnabled(on)
    blurEnabled = on
    if not on then
        TweenService:Create(blur, TweenInfo.new(0.3), {Size = 0}):Play()
    elseif isMenuOpen then
        TweenService:Create(blur, TweenInfo.new(0.3), {Size = 18}):Play()
    end
end

-- ============ ESP ============
local espEnabled = false
local function applyHighlight(character)
    if not character or character == localPlayer.Character then return end
    local h = character:FindFirstChild("PlayerHighlight")
    if not h then
        h = Instance.new("Highlight")
        h.Name = "PlayerHighlight"
        h.FillColor = C.Accent
        h.FillTransparency = 0.5
        h.OutlineTransparency = 0
        h.Adornee = character
        h.Parent = character
    end
    h.FillColor = C.Accent
    h.OutlineColor = OUTLINE_COLORS[currentOutlineIndex].color
end
local function removeHighlight(character)
    if character then
        local h = character:FindFirstChild("PlayerHighlight")
        if h then h:Destroy() end
    end
end
local function setESP(state)
    espEnabled = state
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character then
            if espEnabled then applyHighlight(p.Character) else removeHighlight(p.Character) end
        end
    end
end
local function refreshOutlineColor()
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character then
            local h = p.Character:FindFirstChild("PlayerHighlight")
            if h then
                h.OutlineColor = OUTLINE_COLORS[currentOutlineIndex].color
            end
        end
    end
end

