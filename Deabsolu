local function removeNametag(character)
    if not character then return end
    local bb = character:FindFirstChild("CustomNameTag")
    if bb then bb:Destroy() end
    local head = character:FindFirstChild("Head")
    if head and head:FindFirstChild("CustomNameTag") then head.CustomNameTag:Destroy() end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        humanoid.NameDisplayDistance = 100
        humanoid.HealthDisplayDistance = 100
    end
end
local function setNametags(state)
    nametagsEnabled = state
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character then
            if nametagsEnabled then applyNametag(p.Character) else removeNametag(p.Character) end
        end
    end
end

-- ============ ТРЕЙЛЫ ============
local function applyTrail(character)
    if not character or character == localPlayer.Character then return end
    if character:FindFirstChild("PlayerTrail") then return end
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local a0 = Instance.new("Attachment", hrp); a0.Name = "TrailAttach0"; a0.Position = Vector3.new(0, 1, 0)
    local a1 = Instance.new("Attachment", hrp); a1.Name = "TrailAttach1"; a1.Position = Vector3.new(0, -1, 0)
    local trail = Instance.new("Trail")
    trail.Name = "PlayerTrail"
    trail.Attachment0 = a0
    trail.Attachment1 = a1
    trail.Lifetime = trailLength.lifetime
    trail.MinLength = 0.1
    trail.WidthScale = NumberSequence.new(trailLength.width)
    trail.Color = ColorSequence.new(trailColor)
    trail.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1)})
    trail.LightEmission = 1
    trail.FaceCamera = true
    trail.Parent = character
end
local function removeTrail(character)
    if not character then return end
    local trail = character:FindFirstChild("PlayerTrail")
    if trail then trail:Destroy() end
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if hrp then
        for _, n in ipairs({"TrailAttach0", "TrailAttach1"}) do
            local a = hrp:FindFirstChild(n)
            if a then a:Destroy() end
        end
    end
end
local function setTrails(state)
    trailsEnabled = state
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character then
            if trailsEnabled then applyTrail(p.Character) else removeTrail(p.Character) end
        end
    end
end
local function refreshTrailColor()
    trailColor = TRAIL_COLORS[currentTrailColorIndex].color
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character then
            local trail = p.Character:FindFirstChild("PlayerTrail")
            if trail then trail.Color = ColorSequence.new(trailColor) end
        end
    end
end
local function refreshTrailLength()
    trailLength = TRAIL_LENGTHS[currentTrailLengthIndex]
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character then
            local trail = p.Character:FindFirstChild("PlayerTrail")
            if trail then
                trail.Lifetime = trailLength.lifetime
                trail.WidthScale = NumberSequence.new(trailLength.width)
            end
        end
    end
end

local function onCharacterAdded(character)
    if espEnabled then applyHighlight(character) end
    if nametagsEnabled then applyNametag(character) end
    if trailsEnabled then applyTrail(character) end
end
for _, p in ipairs(Players:GetPlayers()) do p.CharacterAdded:Connect(onCharacterAdded) end
Players.PlayerAdded:Connect(function(p) p.CharacterAdded:Connect(onCharacterAdded) end)

