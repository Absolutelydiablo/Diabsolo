    row.ZIndex = 3
    row.Parent = parent
    Instance.new("UICorner", row).CornerRadius = UDim.new(0, 10)

    local rStroke = Instance.new("UIStroke")
    rStroke.Color = C.Off
    rStroke.Thickness = 1
    rStroke.Transparency = 0.6
    rStroke.Parent = row

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -90, 1, 0)
    lbl.Position = UDim2.new(0, 14, 0, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = labelText
    lbl.TextColor3 = C.Text
    lbl.TextSize = 13
    lbl.Font = Enum.Font.GothamMedium
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.ZIndex = 4
    lbl.Parent = row

    local sw = Instance.new("TextButton")
    sw.Size = UDim2.new(0, 46, 0, 24)
    sw.Position = UDim2.new(1, -58, 0.5, -12)
    sw.BackgroundColor3 = defaultOn and C.Accent or C.Off
    sw.BorderSizePixel = 0
    sw.Text = ""
    sw.AutoButtonColor = false
    sw.ZIndex = 4
    sw.Parent = row
    Instance.new("UICorner", sw).CornerRadius = UDim.new(1, 0)

    local kn = Instance.new("Frame")
    kn.Size = UDim2.new(0, 18, 0, 18)
    kn.Position = defaultOn and UDim2.new(1, -21, 0.5, -9) or UDim2.new(0, 3, 0.5, -9)
    kn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    kn.BorderSizePixel = 0
    kn.ZIndex = 5
    kn.Parent = sw
    Instance.new("UICorner", kn).CornerRadius = UDim.new(1, 0)

    local kShadow = Instance.new("UIStroke")
    kShadow.Color = Color3.fromRGB(0, 0, 0)
    kShadow.Thickness = 1
    kShadow.Transparency = 0.7
    kShadow.Parent = kn

    local ft = TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local state = defaultOn

    sw.MouseButton1Click:Connect(function()
        state = not state
        local tPos = state and UDim2.new(1, -21, 0.5, -9) or UDim2.new(0, 3, 0.5, -9)
        local tCol = state and C.Accent or C.Off
        TweenService:Create(kn, ft, {Position = tPos}):Play()
        TweenService:Create(sw, ft, {BackgroundColor3 = tCol}):Play()
        onChange(state)
    end)

    sw.MouseEnter:Connect(function()
        TweenService:Create(rStroke, ft, {Color = C.Accent, Transparency = 0.3}):Play()
    end)
    sw.MouseLeave:Connect(function()
        TweenService:Create(rStroke, ft, {Color = C.Off, Transparency = 0.6}):Play()
    end)

    table.insert(allSwitches, {
        row = row,
        stroke = rStroke,
        label = lbl,
        sw = sw,
        getState = function() return state end,
    })
end

