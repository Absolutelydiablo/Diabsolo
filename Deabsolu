-- DRAG ПО ВСЕЙ ПЛОЩАДИ МЕНЮ
-- ==========================================================
local menuDragActive = false
local menuDragStart
local menuDragStartPos

local function isOverInteractiveButton(pos)
    for _, obj in ipairs(menu:GetDescendants()) do
        if obj:IsA("GuiButton") and obj.Visible and obj.Active ~= false then
            local ap = obj.AbsolutePosition
            local as = obj.AbsoluteSize
            if pos.X >= ap.X and pos.X <= ap.X + as.X
            and pos.Y >= ap.Y and pos.Y <= ap.Y + as.Y then
                return true
            end
        end
    end
    return false
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.UserInputType ~= Enum.UserInputType.MouseButton1
    and input.UserInputType ~= Enum.UserInputType.Touch then return end
    if not isMenuOpen or not menu.Visible then return end

    local mp = input.Position
    local ap = menu.AbsolutePosition
    local as = menu.AbsoluteSize
    if mp.X < ap.X or mp.X > ap.X + as.X
    or mp.Y < ap.Y or mp.Y > ap.Y + as.Y then return end

    if isOverInteractiveButton(mp) then return end

    menuDragActive = true
    menuDragStart = input.Position
    menuDragStartPos = menu.Position
end)

UserInputService.InputChanged:Connect(function(input)
    if not menuDragActive then return end
    if input.UserInputType ~= Enum.UserInputType.MouseMovement
    and input.UserInputType ~= Enum.UserInputType.Touch then return end
    local delta = input.Position - menuDragStart
    menu.Position = UDim2.new(
        menuDragStartPos.X.Scale, menuDragStartPos.X.Offset + delta.X,
        menuDragStartPos.Y.Scale, menuDragStartPos.Y.Offset + delta.Y
    )
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        menuDragActive = false
    end
end)
