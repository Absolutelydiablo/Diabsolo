local function updateDistances()
    local lp = localPlayer.Character
    local lpRoot = lp and lp:FindFirstChild("HumanoidRootPart")
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= localPlayer and p.Character then
            local head = p.Character:FindFirstChild("Head")
            if head then
                local tag = head:FindFirstChild("CustomNameTag")
                if tag then
                    local dl = tag:FindFirstChild("DistanceLabel")
                    if dl then
                        if showDistance and lpRoot then
                            local dist = (lpRoot.Position - head.Position).Magnitude
                            dl.Text = math.floor(dist * 0.28) .. " m"
                            dl.Visible = true
                        else
                            dl.Visible = false
                        end
                    end
                end
            end
        end
    end
end

-- ============ FPS / PING UPDATE ============
local frames = 0
local lastUpdate = os.clock()

local function getPing()
    local ok, v = pcall(function()
        return Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
    end)
    if ok and typeof(v) == "number" then return math.floor(v) end
    return nil
end

RunService.RenderStepped:Connect(function()
    frames = frames + 1
    local now = os.clock()
    if now - lastUpdate >= 0.5 then
        local fps = math.floor(frames / (now - lastUpdate) + 0.5)
        local fpsColor
        if fps >= 50 then
            fpsColor = Color3.fromRGB(120, 255, 120)
        elseif fps >= 30 then
            fpsColor = Color3.fromRGB(255, 220, 100)
        else
            fpsColor = Color3.fromRGB(255, 70, 80)
        end

        if fpsRoot.Visible then
            fpsLabel.Text = tostring(fps)
            fpsLabel.TextColor3 = fpsColor
        end
        profileFpsValue.Text = tostring(fps)
        profileFpsValue.TextColor3 = fpsColor

        local ping = getPing()
        local pingText = "—"
        if ping then
            pingText = tostring(ping) .. "ms"
            if ping < 60 then
                profilePingValue.TextColor3 = Color3.fromRGB(120, 255, 120)
            elseif ping < 120 then
                profilePingValue.TextColor3 = Color3.fromRGB(255, 220, 100)
            else
                profilePingValue.TextColor3 = Color3.fromRGB(255, 70, 80)
            end
        else
            profilePingValue.TextColor3 = C.SubText
        end
        profilePingValue.Text = pingText

        updateDistances()

        frames = 0
        lastUpdate = now
    end
end)

-- ============ OPEN / CLOSE ============
local CLOSED_SIZE = UDim2.new(0, 0, 0, 0)
local openTween = TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
local closeTween = TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
local fastTween = TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

local function openMenu()
    isMenuOpen = true
    menu.Visible = true
    TweenService:Create(menu, openTween, {Size = OPEN_SIZE}):Play()

    local fadeOut = TweenService:Create(toggleCanvas, fastTween, {GroupTransparency = 1})
    fadeOut:Play()
    fadeOut.Completed:Connect(function()
        if isMenuOpen then toggleCanvas.Visible = false end
    end)

    setBlur(true)
end

local function closeMenu()
    isMenuOpen = false
    TweenService:Create(menu, closeTween, {Size = CLOSED_SIZE}):Play()
    toggleCanvas.Visible = true
    TweenService:Create(toggleCanvas, fastTween, {GroupTransparency = 0}):Play()
    setBlur(false)
end

closeBtn.MouseButton1Click:Connect(closeMenu)

toggleBtn.MouseEnter:Connect(function()
    TweenService:Create(toggleStroke, fastTween, {Transparency = 0}):Play()
end)
toggleBtn.MouseLeave:Connect(function()
    TweenService:Create(toggleStroke, fastTween, {Transparency = 0.3}):Play()
end)

enableDrag(toggleBtn, toggleCanvas, function()
    if not isMenuOpen then openMenu() end
end)

